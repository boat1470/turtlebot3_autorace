<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypelocation="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>arx_ultrasonic_bringup</name>
  <version>0.1.0</version>
  <description>The HC-SR04 on the robot's front, read on the Pi's GPIO, reporting the level crossing bar for arx_mission.</description>
  <maintainer email="claudeseat1@intronics.co.th">boat1470</maintainer>
  <license>Apache 2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>python3-lgpio</exec_depend>
  <exec_depend>ros2launch</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>

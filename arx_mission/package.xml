<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>arx_mission</name>
  <version>0.1.0</version>
  <description>
    Mission sequencing for TurtleBot3 AutoRace: decides which mission is
    active and who is driving. The ROBOTIS example ships the individual
    missions but nothing that chains them, which is what this provides.
  </description>
  <maintainer email="claudeseat1@intronics.co.th">boat1470</maintainer>
  <license>Apache 2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>cv_bridge</depend>
  <depend>python3-opencv</depend>
  <depend>python3-numpy</depend>

  <exec_depend>ros2launch</exec_depend>
  <!-- detect_intersection_sign reads left.png and right.png from this
       package's share/image directory rather than holding its own copy. -->
  <exec_depend>turtlebot3_autorace_detect</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
